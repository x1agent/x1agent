# Copy to terraform.tfvars (gitignored) and fill in.
# `mise run install:plan` writes a generated tfvars from .env.local — see
# packages/cli/src/install/render.ts. Hand-editing is for one-off tweaks.

project_id  = "REPLACE"
base_domain = "REPLACE.com"

# Defaults are sensible. Override only when needed.
# region              = "us-central1"
# zones               = ["us-central1-a"]
# node_machine_type   = "e2-standard-2"
# node_count          = 1
# enable_autoscaling  = false
# use_spot_for_sessions = false
# create_dns_zone     = true
