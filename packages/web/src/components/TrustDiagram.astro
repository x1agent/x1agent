---
// The trust-boundary diagram — the one visual that says "this is not
// hyperagent" in 200ms. Pod boundary on the left (agent + sidecar),
// providers on the right, animated wires between them. Rendered as
// inline SVG so it ships with the document and animates without JS.
---

<div class="relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-6 shadow-2xl shadow-black/40 backdrop-blur md:p-10">
  <div class="absolute -inset-px rounded-2xl bg-gradient-to-b from-white/5 to-transparent pointer-events-none"></div>

  <div class="mb-6 flex items-center justify-between text-xs text-[var(--color-text-faint)]">
    <span class="font-mono">your-namespace / session-9f2c</span>
    <span class="flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] pulse-soft"></span>
      <span>live</span>
    </span>
  </div>

  <svg viewBox="0 0 800 360" class="w-full h-auto" role="img" aria-label="Diagram of an agent session pod, the sidecar trust boundary, and the provider mesh">
    <defs>
      <linearGradient id="podGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1a1a20"/>
        <stop offset="100%" stop-color="#101015"/>
      </linearGradient>
      <linearGradient id="sidecarGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#c5fb45" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#c5fb45" stop-opacity="0.04"/>
      </linearGradient>
      <pattern id="diag" width="6" height="6" patternUnits="userSpaceOnUse">
        <path d="M0 6 L6 0" stroke="#c5fb45" stroke-opacity="0.08" stroke-width="1"/>
      </pattern>
    </defs>

    <!-- Untrusted zone label -->
    <text x="20" y="22" fill="#71717a" font-family="JetBrains Mono, monospace" font-size="10">UNTRUSTED ZONE</text>
    <rect x="20" y="32" width="340" height="300" rx="14" fill="url(#diag)" stroke="#27272a" stroke-width="1" stroke-dasharray="4 3"/>

    <!-- Pod boundary -->
    <rect x="40" y="56" width="300" height="260" rx="10" fill="url(#podGrad)" stroke="#2a2a30" stroke-width="1"/>
    <text x="56" y="80" fill="#a1a1aa" font-family="JetBrains Mono, monospace" font-size="11">pod</text>

    <!-- Agent container -->
    <rect x="56" y="98" width="268" height="92" rx="8" fill="#0d0d10" stroke="#27272a"/>
    <text x="72" y="120" fill="#fafafa" font-family="Inter, sans-serif" font-size="13" font-weight="500">agent container</text>
    <text x="72" y="138" fill="#71717a" font-family="JetBrains Mono, monospace" font-size="10">claude · codex · opencode · gemini</text>
    <text x="72" y="158" fill="#a1a1aa" font-family="Inter, sans-serif" font-size="11">no secrets · no network egress</text>
    <text x="72" y="174" fill="#71717a" font-family="JetBrains Mono, monospace" font-size="10">localhost → sidecar only</text>

    <!-- Sidecar (trust boundary) -->
    <rect x="56" y="206" width="268" height="92" rx="8" fill="url(#sidecarGrad)" stroke="#c5fb45" stroke-width="1.25" stroke-opacity="0.45"/>
    <text x="72" y="228" fill="#fafafa" font-family="Inter, sans-serif" font-size="13" font-weight="500">core sidecar <tspan fill="#c5fb45" font-family="JetBrains Mono, monospace" font-size="10">rust</tspan></text>
    <text x="72" y="246" fill="#a1a1aa" font-family="Inter, sans-serif" font-size="11">holds tokens · enforces grants</text>
    <text x="72" y="264" fill="#71717a" font-family="JetBrains Mono, monospace" font-size="10">credential proxy · permission gate · audit log</text>

    <!-- Trust boundary line / arrow -->
    <line x1="370" y1="120" x2="430" y2="120" stroke="#27272a" stroke-width="1" stroke-dasharray="2 3"/>
    <line x1="370" y1="252" x2="430" y2="252" stroke="#c5fb45" stroke-width="1.25" stroke-opacity="0.5"/>

    <!-- NATS bus column -->
    <text x="395" y="22" fill="#71717a" font-family="JetBrains Mono, monospace" font-size="10">NATS · mTLS</text>
    <line x1="430" y1="56" x2="430" y2="316" stroke="#2a2a30" stroke-width="1"/>
    <line x1="430" y1="56" x2="430" y2="316" stroke="#c5fb45" stroke-opacity="0.15" stroke-width="3"/>

    <!-- Wires from sidecar to providers -->
    <path d="M324 252 Q 380 252 430 200" fill="none" stroke="#c5fb45" stroke-width="1.5" stroke-opacity="0.45" class="wire"/>
    <path d="M324 252 Q 380 252 430 252" fill="none" stroke="#c5fb45" stroke-width="1.5" stroke-opacity="0.45" class="wire" style="animation-delay: -1s"/>
    <path d="M324 252 Q 380 252 430 304" fill="none" stroke="#c5fb45" stroke-width="1.5" stroke-opacity="0.45" class="wire" style="animation-delay: -2s"/>

    <!-- Providers -->
    <text x="500" y="22" fill="#71717a" font-family="JetBrains Mono, monospace" font-size="10">PROVIDER MESH</text>
    <g font-family="Inter, sans-serif" font-size="12" fill="#fafafa">
      <rect x="500" y="80" width="280" height="58" rx="8" fill="#101015" stroke="#27272a"/>
      <text x="516" y="104">messaging</text>
      <text x="516" y="122" font-family="JetBrains Mono, monospace" font-size="10" fill="#71717a">slack · teams · discord</text>

      <rect x="500" y="150" width="280" height="58" rx="8" fill="#101015" stroke="#27272a"/>
      <text x="516" y="174">graph + files</text>
      <text x="516" y="192" font-family="JetBrains Mono, monospace" font-size="10" fill="#71717a">surrealdb · gcs · drive · onedrive</text>

      <rect x="500" y="220" width="280" height="58" rx="8" fill="#101015" stroke="#27272a"/>
      <text x="516" y="244">code + preview</text>
      <text x="516" y="262" font-family="JetBrains Mono, monospace" font-size="10" fill="#71717a">github · gitlab · per-PR k8s preview</text>
    </g>

    <!-- Footnote -->
    <text x="20" y="350" fill="#52525b" font-family="JetBrains Mono, monospace" font-size="9">
      ↑ The agent container can never see the credentials. The sidecar is the only thing on the network.
    </text>
  </svg>
</div>
