---
// Capability tabs — three concrete jobs an agent does end-to-end.
// Each tab opens a "session log" mock that reads like the real thing:
// timestamps, tool calls, output. No interactive demo, just the trail
// of what happened.
---

<section id="capabilities" class="relative border-b border-[var(--color-border)] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-12 max-w-3xl">
      <p class="mb-3 font-mono text-xs tracking-widest text-[var(--color-text-faint)]">01 — WHAT IT DOES</p>
      <h2 class="font-sans text-3xl font-medium tracking-tight md:text-5xl md:leading-[1.1]">
        One platform. <span class="italic font-normal text-[var(--color-accent)]">Three</span> jobs we keep getting asked for.
      </h2>
      <p class="mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
        Pick a job. Watch the session unfold. Every tool call, every credential check, every artifact — logged in the same place.
      </p>
    </div>

    <div id="tabs" class="grid gap-10 md:grid-cols-[260px_1fr]">
      <div role="tablist" class="flex flex-col gap-1">
        <button
          type="button"
          data-tab="ship"
          aria-selected="true"
          class="tab-trigger group flex items-start gap-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]/50 px-4 py-4 text-left transition aria-selected:border-[var(--color-accent)]/40 aria-selected:bg-[var(--color-accent-soft)]"
        >
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-text-faint)] group-aria-selected:bg-[var(--color-accent)]"></span>
          <span>
            <span class="block text-sm font-medium text-[var(--color-text)]">Ship a feature</span>
            <span class="block text-xs text-[var(--color-text-muted)]">multi-agent · code · review</span>
          </span>
        </button>

        <button
          type="button"
          data-tab="triage"
          aria-selected="false"
          class="tab-trigger group flex items-start gap-3 rounded-lg border border-transparent px-4 py-4 text-left transition hover:bg-[var(--color-surface)]/40 aria-selected:border-[var(--color-accent)]/40 aria-selected:bg-[var(--color-accent-soft)]"
        >
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-text-faint)] group-aria-selected:bg-[var(--color-accent)]"></span>
          <span>
            <span class="block text-sm font-medium text-[var(--color-text)]">Triage the inbox</span>
            <span class="block text-xs text-[var(--color-text-muted)]">slack · linear · email</span>
          </span>
        </button>

        <button
          type="button"
          data-tab="oncall"
          aria-selected="false"
          class="tab-trigger group flex items-start gap-3 rounded-lg border border-transparent px-4 py-4 text-left transition hover:bg-[var(--color-surface)]/40 aria-selected:border-[var(--color-accent)]/40 aria-selected:bg-[var(--color-accent-soft)]"
        >
          <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-text-faint)] group-aria-selected:bg-[var(--color-accent)]"></span>
          <span>
            <span class="block text-sm font-medium text-[var(--color-text)]">Run on-call</span>
            <span class="block text-xs text-[var(--color-text-muted)]">pagerduty · grafana · kubectl</span>
          </span>
        </button>
      </div>

      <div class="relative min-h-[460px]">
        <!-- Ship a feature -->
        <div data-panel="ship" data-active="true" class="tab-panel">
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/40 p-6 backdrop-blur md:p-8">
            <p class="mb-1 text-xs font-mono text-[var(--color-text-faint)]">SESSION 7a4f · ORCHESTRATOR</p>
            <h3 class="mb-4 text-xl font-medium md:text-2xl">
              Take a Linear ticket through to a reviewed PR.
            </h3>
            <p class="mb-6 max-w-2xl text-[var(--color-text-muted)]">
              The orchestrator pulls the ticket, spawns a coding agent in a fresh preview environment, runs the test suite in a sibling pod, and posts the diff back to the channel where it started.
            </p>
            <ol class="space-y-4 font-mono text-[13px]">
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">12:04:11</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">linear.get_issue</span>("ENG-417") → "Add slug field to workspaces"</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">12:04:18</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">spawn_child</span>("codex", branch="eng-417-slug")</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">12:09:42</span>
                <span class="text-[var(--color-text-muted)]">child wrote 3 files · migration · model · test</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">12:10:55</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">sibling.run</span>("bun test") → 218 pass · 0 fail</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">12:11:08</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">github.open_pr</span>(base="main") → #1042</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">12:11:14</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">slack.post</span>(#eng) → "PR ready · diff +87 −2 · preview link"</span>
              </li>
            </ol>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">github</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">linear</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">slack</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">k8s preview env</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">codex runtime</span>
            </div>
          </div>
        </div>

        <!-- Triage the inbox -->
        <div data-panel="triage" class="tab-panel">
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/40 p-6 backdrop-blur md:p-8">
            <p class="mb-1 text-xs font-mono text-[var(--color-text-faint)]">SESSION 3c91 · SUPPORT AGENT</p>
            <h3 class="mb-4 text-xl font-medium md:text-2xl">
              Read the room. Then file a ticket and reply.
            </h3>
            <p class="mb-6 max-w-2xl text-[var(--color-text-muted)]">
              The agent watches a Slack channel, classifies what came in, looks up the customer, drafts a reply. Sentiment goes hot — it stops typing and pages a human.
            </p>
            <ol class="space-y-4 font-mono text-[13px]">
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:03</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">slack.message_in</span>(#support) → "checkout fails on Safari, lost a sale"</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:07</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">classify</span>() → bug · severity=high · sentiment=frustrated</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:09</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">graph.lookup_customer</span>("acme") → 14 mo · $2.1k MRR</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:14</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">linear.create_issue</span>("CHK-218", priority=urgent)</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:16</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">draft_reply</span>() → 3 sentences · acknowledges revenue impact</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:17</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">policy.check</span>() → high-MRR · sentiment=hot → handoff_to_human</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">09:22:18</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">pagerduty.notify</span>("oncall-support", "draft attached")</span>
              </li>
            </ol>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">slack</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">linear</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">surrealdb graph</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">pagerduty</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">handoff policy</span>
            </div>
          </div>
        </div>

        <!-- Run on-call -->
        <div data-panel="oncall" class="tab-panel">
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/40 p-6 backdrop-blur md:p-8">
            <p class="mb-1 text-xs font-mono text-[var(--color-text-faint)]">SESSION e08d · SRE AGENT</p>
            <h3 class="mb-4 text-xl font-medium md:text-2xl">
              First responder for the alert that wakes you up.
            </h3>
            <p class="mb-6 max-w-2xl text-[var(--color-text-muted)]">
              PagerDuty fires. The agent pulls the relevant Grafana panels, runs read-only kubectl through the sidecar, and posts a runbook-shaped summary to the incident channel before a human even opens the laptop.
            </p>
            <ol class="space-y-4 font-mono text-[13px]">
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">02:14:02</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">pagerduty.alert</span>("api p99 &gt; 1.2s for 5m")</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">02:14:05</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">grafana.snapshot</span>("api-latency") → p99=1.4s · p50 flat</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">02:14:08</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">k8s.get_pods</span>(ns=api) → 2/4 ready · 1 OOMKilled</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">02:14:10</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">k8s.logs</span>(api-7c · last 200) → Postgres connection pool exhausted</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">02:14:14</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">postgres.read</span>("pg_stat_activity") → 198 idle · 2 active</span>
              </li>
              <li class="flex gap-3">
                <span class="w-16 shrink-0 text-[var(--color-text-faint)]">02:14:18</span>
                <span class="text-[var(--color-text-muted)]"><span class="text-[var(--color-accent)]">slack.post</span>(#incident) → summary · graph · likely cause · suggested next step</span>
              </li>
            </ol>
            <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">pagerduty</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">grafana</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">kubectl read-only</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">postgres read-only</span>
              <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 text-[var(--color-text-muted)]">slack</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(".tab-trigger");
  const panels = document.querySelectorAll<HTMLDivElement>(".tab-panel");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const tab = trigger.dataset.tab;
      triggers.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === tab)));
      panels.forEach((p) => p.setAttribute("data-active", String(p.dataset.panel === tab)));
    });
  });
</script>
