---
// Sign-up section. No "free trial", no "credit card required" — the
// CTA is "tell us what you'd build, we'll get you set up." Email
// goes to Resend (audience + transactional notify).
---

<section id="access" class="relative overflow-hidden border-b border-[var(--color-border)] py-24 md:py-32">
  <div class="absolute inset-x-0 top-0 -z-10 h-full bg-gradient-to-b from-transparent via-[var(--color-accent-soft)] to-transparent opacity-40"></div>

  <div class="mx-auto grid max-w-6xl items-start gap-12 px-6 md:grid-cols-[1fr_1fr]">
    <div>
      <p class="mb-3 font-mono text-xs tracking-widest text-[var(--color-text-faint)]">04 — GET ACCESS</p>
      <h2 class="font-sans text-3xl font-medium tracking-tight md:text-5xl md:leading-[1.05]">
        We're onboarding teams <span class="italic font-normal text-[var(--color-accent)]">one at a time</span>.
      </h2>
      <p class="mt-5 max-w-md text-[var(--color-text-muted)] md:text-lg">
        x1agent is in private beta. Tell us what you'd build and we'll set up a call to walk through your cluster.
      </p>
      <ul class="mt-8 space-y-3 text-sm text-[var(--color-text-muted)]">
        <li class="flex items-start gap-2.5">
          <svg viewBox="0 0 16 16" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 8l3.5 3.5L13 5"/></svg>
          One pricing tier today — flat per-cluster, no per-seat math.
        </li>
        <li class="flex items-start gap-2.5">
          <svg viewBox="0 0 16 16" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 8l3.5 3.5L13 5"/></svg>
          Self-hosted. Your VPC, your secrets, your audit log.
        </li>
        <li class="flex items-start gap-2.5">
          <svg viewBox="0 0 16 16" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 8l3.5 3.5L13 5"/></svg>
          Direct line to the people who write the code.
        </li>
      </ul>
    </div>

    <form
      id="access-form"
      method="POST"
      action="/api/signup"
      class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 p-7 backdrop-blur"
    >
      <div class="space-y-4">
        <label class="block">
          <span class="mb-1.5 block font-mono text-[11px] tracking-wider text-[var(--color-text-faint)]">NAME</span>
          <input
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-md border border-[var(--color-border-strong)] bg-[var(--color-bg)] px-3 py-2.5 text-sm text-[var(--color-text)] outline-none transition placeholder:text-[var(--color-text-faint)] focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
            placeholder="Ada Lovelace"
          />
        </label>

        <label class="block">
          <span class="mb-1.5 block font-mono text-[11px] tracking-wider text-[var(--color-text-faint)]">WORK EMAIL</span>
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-md border border-[var(--color-border-strong)] bg-[var(--color-bg)] px-3 py-2.5 text-sm text-[var(--color-text)] outline-none transition placeholder:text-[var(--color-text-faint)] focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
            placeholder="ada@yourcompany.com"
          />
        </label>

        <label class="block">
          <span class="mb-1.5 block font-mono text-[11px] tracking-wider text-[var(--color-text-faint)]">WHAT WOULD YOU BUILD FIRST?</span>
          <textarea
            name="intent"
            rows="3"
            class="w-full rounded-md border border-[var(--color-border-strong)] bg-[var(--color-bg)] px-3 py-2.5 text-sm text-[var(--color-text)] outline-none transition placeholder:text-[var(--color-text-faint)] focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent-soft)]"
            placeholder="An on-call agent that pages me only when it's actually a human's problem."
          ></textarea>
        </label>

        <input type="text" name="company" tabindex="-1" autocomplete="off" class="absolute -left-[9999px]" aria-hidden="true" />

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-accent)] px-5 py-3 text-sm font-medium text-[var(--color-bg)] transition hover:opacity-90"
        >
          <span data-state="idle">Request access</span>
          <span data-state="loading" class="hidden">Sending…</span>
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 8h8M9 5l3 3-3 3"/></svg>
        </button>

        <p data-form-message class="hidden text-sm" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("access-form") as HTMLFormElement | null;
  if (form) {
    const message = form.querySelector<HTMLParagraphElement>("[data-form-message]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const idleLabel = form.querySelector<HTMLSpanElement>("[data-state=idle]");
    const loadingLabel = form.querySelector<HTMLSpanElement>("[data-state=loading]");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!button || !message) return;

      button.disabled = true;
      idleLabel?.classList.add("hidden");
      loadingLabel?.classList.remove("hidden");
      message.classList.add("hidden");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (response.ok && data.ok) {
          form.reset();
          message.textContent = "Got it. Check your inbox — Christian will reach out within a day.";
          message.className = "text-sm text-[var(--color-accent)]";
        } else {
          message.textContent = data.error ?? "Something broke. Email christian@x1agent.com directly.";
          message.className = "text-sm text-red-400";
        }
      } catch {
        message.textContent = "Network error. Email christian@x1agent.com directly.";
        message.className = "text-sm text-red-400";
      } finally {
        button.disabled = false;
        idleLabel?.classList.remove("hidden");
        loadingLabel?.classList.add("hidden");
      }
    });
  }
</script>
