---
// The provider mesh strip. Lists what's shipping today (honest about
// what's not yet there). A Helm-value snippet underneath shows that
// switching providers is a config change, not a refactor.

// Pre-render the highlighted YAML as a single HTML string so neither
// the Astro template parser nor JSX-style expression evaluation sees
// the literal `{` characters inside the snippet.
const yamlHtml = [
  '<span style="color: var(--color-text-faint)"># Slack today. Teams next quarter — flip one line.</span>',
  'providers:',
  '  messaging:',
  '    name: <span style="color: var(--color-accent)">slack</span>',
  '    botToken: <span style="color: var(--color-text)">SECRETREF_SLACK</span>',
  '  files:',
  '    name: <span style="color: var(--color-accent)">google-drive</span>',
  '    serviceAccount: <span style="color: var(--color-text)">SECRETREF_GDRIVE</span>',
  '  graph:',
  '    name: <span style="color: var(--color-accent)">surrealdb</span>',
]
  .join("\n")
  .split("SECRETREF_SLACK").join("{ secretRef: slack-bot }")
  .split("SECRETREF_GDRIVE").join("{ secretRef: gdrive-sa }");
---

<section id="providers" class="relative border-b border-[var(--color-border)] py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-12 max-w-3xl">
      <p class="mb-3 font-mono text-xs tracking-widest text-[var(--color-text-faint)]">03 — PROVIDERS</p>
      <h2 class="font-sans text-3xl font-medium tracking-tight md:text-5xl md:leading-[1.1]">
        Swap providers on a Helm <span class="italic font-normal text-[var(--color-accent)]">value</span>.
      </h2>
      <p class="mt-5 max-w-2xl text-[var(--color-text-muted)] md:text-lg">
        Authentication, knowledge graph, file storage, messaging, calendar, code host — each one is a contract, not an integration. Today we ship the providers below. Implementing your own is a couple hundred lines of TypeScript.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-border)] md:grid-cols-3">
      {[
        { domain: "auth", today: ["google", "github oauth"], next: "okta" },
        { domain: "graph", today: ["surrealdb"], next: "neo4j" },
        { domain: "files", today: ["gcs", "google drive"], next: "s3, onedrive" },
        { domain: "messaging", today: ["slack"], next: "teams, discord" },
        { domain: "code", today: ["github"], next: "gitlab" },
        { domain: "ai runtime", today: ["claude", "codex", "opencode", "gemini"], next: "any sdk that speaks tools" },
      ].map(({ domain, today, next }) => (
        <div class="bg-[var(--color-surface)] p-5">
          <p class="mb-3 font-mono text-[11px] tracking-wider text-[var(--color-text-faint)]">{domain.toUpperCase()}</p>
          <div class="mb-4 flex flex-wrap gap-1.5">
            {today.map((name) => (
              <span class="rounded-md border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-2 py-0.5 text-xs text-[var(--color-text)]">{name}</span>
            ))}
          </div>
          <p class="font-mono text-[11px] text-[var(--color-text-faint)]">next: <span class="text-[var(--color-text-muted)]">{next}</span></p>
        </div>
      ))}
    </div>

    <div class="mt-10 overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/40">
      <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-2.5">
        <span class="font-mono text-xs text-[var(--color-text-faint)]">values.yaml</span>
        <span class="font-mono text-[10px] tracking-wide text-[var(--color-text-faint)]">HELM</span>
      </div>
      <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed text-[var(--color-text-muted)]"><code set:html={yamlHtml} /></pre>
    </div>
  </div>
</section>
