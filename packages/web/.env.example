# Resend transactional + audience. Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — Resend audience id for the waitlist. Without this, signups
# still notify christian@ but aren't added to a list for batch follow-up.
RESEND_AUDIENCE_ID=

# Sender for both visitor ack + internal notification. Once x1agent.com
# is verified in Resend, set this to "x1agent <christian@x1agent.com>".
# Until verification, the resend.dev sandbox sender works.
WEB_FROM_EMAIL=x1agent <onboarding@resend.dev>
