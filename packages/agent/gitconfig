# Agent container git config.
#
# The credential helper binary shells out to the sidecar, which mints a
# scoped GitHub App installation token on demand. The agent container
# never holds the raw token. See docs/security/credential-proxy.md.

[credential]
    helper = /usr/local/bin/git-credential-x1

[user]
    name = x1agent
    email = agent@x1agent.local

[safe]
    directory = *

[init]
    defaultBranch = main
