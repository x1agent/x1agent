---
import Layout from "../layouts/Layout.astro";
---

<Layout title="No access · x1agent">
  <div class="flex min-h-[calc(100vh-57px)] items-center justify-center px-6">
    <div class="w-full max-w-sm space-y-4 text-center">
      <h1 class="text-xl font-semibold">No workspace access</h1>
      <p class="text-sm text-zinc-400">
        Your Google account is not a member of any workspace. Contact an
        administrator to get access.
      </p>
      <a
        href="/"
        class="inline-block text-sm text-zinc-300 underline hover:text-white"
      >
        Back to sign in
      </a>
    </div>
  </div>
</Layout>
