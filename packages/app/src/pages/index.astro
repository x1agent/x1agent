---
import Layout from "../layouts/Layout.astro";
import { SignedOutGate } from "../features/auth/SignedOutGate";
---

<Layout title="Sign in · x1agent">
  <div class="flex min-h-[calc(100vh-57px)] items-center justify-center px-6">
    <div class="w-full max-w-sm space-y-6 text-center">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">x1agent</h1>
        <p class="mt-2 text-sm text-fg-muted">
          Open-source, Kubernetes-native agent platform.
        </p>
      </div>
      <SignedOutGate client:load />
    </div>
  </div>
</Layout>
