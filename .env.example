# LOCAL DEV ONLY.
#
# Copy this file to .env.local (or run `mise run configure` and pick
# "Local development" — it writes the file for you). .env.local is
# gitignored.
#
# IMPORTANT: install/deploy configuration does NOT live here.
# Per-deployment install config (cloud target, base domain, GCP project
# ID, secrets that go to GSM, etc.) lives in `installs/<base-domain>.local`
# — see `installs/example.local`. Keeping the two file paths separate
# means a contributor can have local dev set up without ever seeing
# production deployment values.
#
# Variables you might wonder why aren't here:
#   - PUBLIC_URL, API_PUBLIC_URL  — derived from BASE_DOMAIN by the chart
#                                    + manifests. Never user input.
#   - DATABASE_URL, NATS_URL      — hardcoded in the dev manifests under
#                                    deploy/k8s/dev/. Never user input.
#   - PLATFORM_NAME               — defaulted to "x1agent" everywhere.
#   - GCP / Vertex / Anthropic    — install-only; lives in installs/<...>.local

# ============================================================================
#
#
# automatically. Override only if needed.
# ============================================================================


# ============================================================================
# Dev login bypass
#
# AUTH_BYPASS=true makes the api skip Google OAuth on the local
# /auth/dev-bypass endpoint. Pair with TEST_USER to seed an account on
# first migration. Never set in production — there's no auth at all when
# AUTH_BYPASS=true.
# ============================================================================

AUTH_BYPASS=false
TEST_USER=

# ============================================================================
# Image uploads (X1A-96)
#
# UPLOAD_STORAGE_BACKEND selects the block-storage adapter:
#   - local — LocalDiskStorage (dev default). Bytes land under
#             UPLOAD_STORAGE_PATH; the api process signs short-lived
#             PUT URLs that the browser hits directly.
#   - s3    — S3Storage. Requires UPLOAD_S3_BUCKET (+ optional
#             UPLOAD_S3_REGION); auth via the standard AWS credentials
#             chain. The S3 SDK is loaded lazily and must be installed
#             in packages/api when this mode is selected.
#
# Other knobs all have documented defaults — leave unset unless tuning.
# ============================================================================

UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_PATH=./data/uploads
# UPLOAD_S3_BUCKET=
# UPLOAD_S3_REGION=us-east-1
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_ALLOWED_MIMES=image/png,image/jpeg,image/gif,image/webp
# UPLOAD_PENDING_TTL_HOURS=24
# UPLOAD_ATTACHED_TTL_DAYS=30
# UPLOAD_RATE_INIT_PER_MIN=60
# UPLOADS_CLEANUP_INTERVAL_MS=3600000
# UPLOADS_CLEANUP_DISABLED=false
