# Copy this file to .env.local and fill in values.
# .env.local is gitignored. Do not commit real secrets.

# === Google OAuth ===
# Create an OAuth 2.0 Client ID in GCP console with
# redirect URI http://localhost:30001/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated list of Google Workspace domains allowed to sign in.
# Leave blank to allow any verified Google account.
ALLOWED_DOMAINS=

# === JWT signing ===
# Generate with: openssl rand -hex 32
JWT_SECRET=

# === Local dev config ===
PLATFORM_NAME=x1agent
PUBLIC_URL=http://localhost:4321
API_PUBLIC_URL=http://localhost:30001
DATABASE_URL=postgresql://x1agent:x1agent@localhost:5432/x1agent
NATS_URL=nats://localhost:4222

# === Test user (optional) ===
# A Google email to seed into the users table on first migration
# so local dev doesn't require manual workspace membership.
TEST_USER=
TEST_PASSWORD=
