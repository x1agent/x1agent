examples/
.env.*
!.env.example
CLAUDE.local.md
node_modules/
dist/
.devspace/
MEMORY.md
.local/

# Per-deployment install config — generated by `mise run configure` on
# the deployment path. One file per deployment (e.g. installs/x1agent.com.local).
# Carries the values that drive `mise run terraform:apply` + `install:apply`.
installs/*.local

# Per-deployment Helm values rendered by `mise run configure`. The chart's
# `values.yaml` is the committed default; `values.<basedomain>.yaml` is
# install-specific and contains admin emails / base domain.
deploy/helm/x1agent/values.*.yaml
!deploy/helm/x1agent/values.yaml

# Local Claude Code runtime state.
.claude/scheduled_tasks.lock
.claude/skills/

# Astro generated content / type files (regenerated on `astro dev`).
.astro/

# Local-only test scripts that aren't part of the test suite.
test-site.mjs
